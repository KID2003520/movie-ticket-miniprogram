%% 电影票小程序 - 用户模块图
%% 在线预览并导出图：在浏览器打开支持 Mermaid 的编辑器，粘贴全文

flowchart TB
  subgraph UM["用户模块"]
    subgraph FE["小程序端"]
      U0["个人中心页"]
      U1["登录页"]
      U2["注册页"]
      U3["设置页"]
      U4["客服中心页"]
      U5["菜单：我的订单、我的收藏、优惠券等"]
    end

    subgraph API["服务端"]
      A1["注册：手机号 + 密码"]
      A2["登录：手机号 + 密码"]
      A3["用户统计、各状态订单数量、收藏数等"]
      A4["权限：是否管理员、角色、等级"]
    end

    subgraph DATA["数据库"]
      D1[("用户表")]
      D2[("与订单、收藏、优惠券等关联的数据")]
    end

    U0 --> U1
    U0 --> U2
    U0 --> U5
    U1 --> A2
    U2 --> A1
    U1 --> A4
    U0 --> A3
    A1 --> D1
    A2 --> D1
    A3 --> D2
    D2 --> D1
  end
