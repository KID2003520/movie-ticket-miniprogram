# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=movie_ticket_db

PORT=3000

# 可选：同时开 HTTPS，供小程序 <image> 走 https://本机IP:端口/api/poster-proxy（需自签证书，开发者工具可勾选不校验证书）
# HTTPS_PORT=3443
# HTTPS_KEY_PATH=./certs/localhost-key.pem
# HTTPS_CERT_PATH=./certs/localhost-cert.pem
# 生成自签示例（需已安装 OpenSSL）:
#   mkdir certs && cd certs
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout localhost-key.pem -out localhost-cert.pem -days 3650 -subj "/CN=localhost"

# TMDB 电影资料同步（海报、简介、演职员等）https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# 国内访问 TMDB 不稳定时：配置本地代理（如 Clash 开启「允许局域网连接」后，常见为下面端口之一）
# HTTPS_PROXY=http://127.0.0.1:7890
# 代理未启动会导致 ECONNRESET；直连可用时可设 TMDB_DISABLE_PROXY=1
# TMDB_DISABLE_PROXY=1
# 或 HTTP_PROXY=http://127.0.0.1:7890

# 单次请求超时（毫秒，建议 ≥20000）
# TMDB_REQUEST_TIMEOUT_MS=28000
# 失败重试次数与间隔（毫秒）
# TMDB_REQUEST_MAX_ATTEMPTS=8
# TMDB_REQUEST_RETRY_DELAY_MS=1000

# 默认仅从 TMDB 拉片；仅当 TMDB 列表请求失败且你仍想兜底国内猫眼时，再设下面一项为 1（会得到库内 _id 形如 tmdb_maoyan_*）
# TMDB_MAOYAN_FALLBACK=1
# 若已开猫眼兜底、又想临时关掉：可设 TMDB_NO_MAOYAN_FALLBACK=1
# TMDB_NO_MAOYAN_FALLBACK=1

# 可选：设置后，所有 TMDB 导入/补全/重算接口需在请求头带 x-sync-secret: 同值
# 小程序端请在 utils/config.js 填 TMDB_SYNC_SECRET，或 wx.setStorageSync('tmdbSyncSecret','同值')
# TMDB_SYNC_SECRET=

# 可选：导入新电影时的默认票价（分）
# DEFAULT_MOVIE_PRICE_CENTS=3500

# 可选：腾讯位置服务 WebService Key，用于小程序首页/逆地理显示城市（https://lbs.qq.com/console/mykey.html）
# 不配也可定位：wx.getLocation 仍可用，仅接口返回 city 为空，界面显示「已定位」
# TENCENT_LBS_KEY=

# —— 支付宝（手机网站支付 alipay.trade.wap.pay，用于购票）——
# 开放平台创建应用后填写；密钥为 PEM 内容或单行 base64（可带 \\n 换行）。
# 沙箱网关示例：https://openapi.alipaydev.com/gateway.do
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_APP_ID=
# 应用私钥（PKCS8 时设 ALIPAY_KEY_TYPE=PKCS8）
# ALIPAY_KEY_TYPE=PKCS8
# ALIPAY_PRIVATE_KEY=
# 支付宝公钥（非应用公钥）：ALIPAY_ALIPAY_PUBLIC_KEY 或 ALIPAY_PUBLIC_KEY
# ALIPAY_ALIPAY_PUBLIC_KEY=
# 对外可访问的 HTTPS 根地址，无尾斜杠；异步通知与支付跳转依赖此地址（需支付宝后台配置 notify 白名单）
# PUBLIC_BASE_URL=https://你的域名
# 可选：支付跳转页 token 签名密钥（生产环境务必自定义）
# PAY_BRIDGE_SECRET=

# 会员积分：每 100 分（1 元）实付对应积分倍数（默认 1）；每日签到积分（默认 10）
# POINTS_PER_100_CENTS=1
# POINTS_CHECKIN_DAILY=10

