page {
  background-color: #f5f5f5;
  color: #121212;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tp-page {
  min-height: 100vh;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.tp-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(18, 18, 18, 0.06);
}

.tp-title {
  font-size: 36rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #121212;
}

.tp-subtitle {
  font-size: 24rpx;
  line-height: 1.4;
  color: #8a8a8a;
}

.tp-price {
  color: #ff5f16;
  font-weight: 700;
}

.tp-btn-primary {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tp-btn-primary:active {
  opacity: 0.9;
}

.tp-btn-ghost {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  border: 2rpx solid #ffd5c2;
  color: #ff5f16;
  font-size: 24rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tp-row {
  display: flex;
  align-items: center;
}

.tp-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tp-empty {
  padding: 120rpx 24rpx;
  text-align: center;
  color: #999999;
}

/* 自定义 tabBar 页面底部留白（淘票票式底栏高度 + 安全区） */
.tab-page-safe {
  padding-bottom: calc(110rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
