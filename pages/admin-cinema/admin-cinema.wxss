.container { min-height: 100vh; background: #f5f6f8; padding: 20rpx; box-sizing: border-box; }
.toolbar { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.search-input { flex: 1; background: #fff; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 26rpx; }
.search-btn { width: 120rpx; background: #ff5f16; color: #fff; border-radius: 12rpx; text-align: center; line-height: 72rpx; font-size: 26rpx; }
.add-btn { background: #fff; color: #ff5f16; border: 1rpx solid #ff5f16; border-radius: 12rpx; text-align: center; padding: 18rpx 0; margin-bottom: 16rpx; font-size: 28rpx; }
.list { display: flex; flex-direction: column; gap: 14rpx; }
.item { background: #fff; border-radius: 14rpx; padding: 18rpx; display: flex; gap: 12rpx; justify-content: space-between; }
.item-main { flex: 1; }
.name { display: block; font-size: 30rpx; color: #222; font-weight: 600; margin-bottom: 8rpx; }
.meta { display: block; font-size: 22rpx; color: #777; line-height: 1.5; }
.item-actions { display: flex; flex-direction: column; justify-content: center; gap: 12rpx; }
.action { width: 96rpx; text-align: center; padding: 10rpx 0; border-radius: 10rpx; font-size: 24rpx; }
.halls { background: #fff7e6; color: #d46b08; }
.edit { background: #eef5ff; color: #3d7bff; }
.del { background: #fff0f0; color: #ff4d4f; }
.empty, .loading { text-align: center; color: #999; font-size: 24rpx; padding: 40rpx 0; }
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 10; }
.modal { position: fixed; left: 24rpx; right: 24rpx; top: 80rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; z-index: 11; }
.modal-title { font-size: 30rpx; color: #222; font-weight: 600; margin-bottom: 16rpx; }
.field { background: #f7f8fa; border-radius: 10rpx; padding: 16rpx; font-size: 24rpx; margin-bottom: 12rpx; }
.modal-actions { display: flex; gap: 12rpx; margin-top: 10rpx; }
.btn { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 10rpx; font-size: 26rpx; }
.cancel { background: #f2f3f5; color: #666; }
.ok { background: #ff5f16; color: #fff; }
