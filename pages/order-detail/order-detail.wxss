.order-detail-page {
  padding: 16rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.status-card {
  border-radius: 14rpx;
  padding: 20rpx;
  color: #fff;
}

.status-card.pending {
  background: linear-gradient(90deg, #ff8f2e 0%, #ff612f 100%);
}

.status-card.paid {
  background: linear-gradient(90deg, #18ad63 0%, #28c773 100%);
}

.status-card.refunding,
.status-card.refunded {
  background: linear-gradient(90deg, #4f7ff0 0%, #5fa1ff 100%);
}

.status-card.cancelled {
  background: linear-gradient(90deg, #9d9d9d 0%, #b9b9b9 100%);
}

.status-text {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.countdown {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.95;
}

.movie-card {
  margin-top: 14rpx;
  border-radius: 14rpx;
  background-color: #fff;
  padding: 18rpx;
  display: flex;
}

.movie-poster {
  width: 118rpx;
  height: 156rpx;
  border-radius: 8rpx;
}

.movie-main {
  margin-left: 12rpx;
  flex: 1;
}

.movie-title {
  display: block;
  font-size: 29rpx;
  color: #121212;
  font-weight: 700;
}

.movie-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

.block {
  margin-top: 14rpx;
  border-radius: 14rpx;
  background-color: #fff;
  padding: 18rpx;
}

.block-title {
  display: block;
  font-size: 27rpx;
  color: #121212;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.seat-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.seat-item {
  font-size: 21rpx;
  color: #ff5f16;
  background-color: #fff2eb;
  border-radius: 6rpx;
  padding: 4rpx 8rpx;
}

.qr-block {
  text-align: center;
}

.qrcode {
  width: 240rpx;
  height: 240rpx;
}

.kv {
  min-height: 52rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 23rpx;
  color: #666;
  border-bottom: 1rpx solid #f2f2f2;
}

.kv:last-child {
  border-bottom: none;
}

.copy {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.copy-btn {
  font-size: 20rpx;
  color: #ff5f16;
  border: 1rpx solid #ffd5c2;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.kv.total {
  margin-top: 6rpx;
}

.price {
  font-size: 29rpx;
  color: #ff5f16;
  font-weight: 700;
}

.coupon-row .coupon-cell {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.coupon-applied {
  color: #ff5f16;
  font-size: 23rpx;
}

.coupon-placeholder {
  color: #999;
  font-size: 23rpx;
}

.coupon-arrow {
  color: #ccc;
  font-size: 22rpx;
}

.origin-price {
  color: #999;
  text-decoration: line-through;
}

.discount-price {
  color: #18ad63;
}

.coupon-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.coupon-picker {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.picker-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.picker-content {
  max-height: 55vh;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.coupon-option {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.option-left {
  width: 180rpx;
  background: linear-gradient(135deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 10rpx;
}

.option-amount {
  font-size: 36rpx;
  font-weight: 700;
}

.option-condition {
  font-size: 20rpx;
  margin-top: 6rpx;
  opacity: 0.9;
}

.option-right {
  flex: 1;
  padding: 20rpx;
}

.option-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.option-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.picker-footer {
  padding: 16rpx 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.picker-remove {
  text-align: center;
  color: #666;
  font-size: 26rpx;
  padding: 16rpx 0;
}

.action-bar {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.btn {
  flex: 1;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 25rpx;
  border-radius: 29rpx;
}

.btn.primary {
  color: #fff;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
}

.btn.alipay {
  color: #fff;
  background: linear-gradient(90deg, #1677ff 0%, #0958d9 100%);
}

.btn.ghost {
  color: #ff5f16;
  background-color: #fff2eb;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 24rpx;
}
