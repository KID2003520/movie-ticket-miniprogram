.container {
  padding-bottom: 20rpx;
}

.cinema-header {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.cinema-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.cinema-address {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.cinema-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 22rpx;
  color: #FF6B6B;
  border: 1rpx solid #FF6B6B;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.cinema-phone,
.cinema-location {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.date-bar {
  background-color: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.date-scroll {
  white-space: nowrap;
}

.date-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 30rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
}

.date-item.active {
  background-color: #FF6B6B;
}

.date-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.date-item.active .date-text {
  color: #fff;
}

.week-text {
  font-size: 24rpx;
  color: #999;
}

.date-item.active .week-text {
  color: #fff;
}

.schedule-list {
  padding: 0 20rpx;
}

.schedule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.schedule-time {
  display: flex;
  flex-direction: column;
  margin-right: 20rpx;
}

.start-time {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.end-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.schedule-info {
  flex: 1;
}

.hall-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.hall-type {
  font-size: 24rpx;
  color: #999;
}

.schedule-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price {
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.buy-btn {
  background-color: #FF6B6B;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
