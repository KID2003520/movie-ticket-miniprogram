.cinema-detail-page {
  padding: 16rpx 24rpx 20rpx;
  box-sizing: border-box;
}

.cinema-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
}

.cinema-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #121212;
}

.cinema-address {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

.cinema-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  color: #ff5f16;
  border: 1rpx solid #ffd5c2;
}

.cinema-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.action {
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  background-color: #f7f7f7;
  font-size: 22rpx;
  color: #666;
}

.date-bar {
  margin-top: 14rpx;
}

.date-list {
  display: inline-flex;
  gap: 10rpx;
}

.date-item {
  width: 120rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background-color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.date-item.active {
  background-color: #ff5f16;
}

.date-text {
  font-size: 24rpx;
  color: #333;
}

.week-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #999;
}

.date-item.active .date-text,
.date-item.active .week-text {
  color: #fff;
}

.schedule-list {
  margin-top: 14rpx;
}

.movie-bar {
  margin-top: 14rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 14rpx 10rpx;
}

.movie-list {
  display: inline-flex;
  gap: 12rpx;
}

.movie-item {
  width: 130rpx;
  padding: 8rpx;
  border-radius: 10rpx;
  border: 1rpx solid transparent;
}

.movie-item.active {
  border-color: #ff5f16;
  background: #fff7f2;
}

.movie-poster {
  width: 114rpx;
  height: 150rpx;
  border-radius: 8rpx;
  display: block;
}

.movie-title {
  margin-top: 8rpx;
  width: 114rpx;
  display: block;
  font-size: 21rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.schedule-item {
  background-color: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.schedule-time {
  width: 148rpx;
}

.start-time {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #121212;
}

.end-time {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999;
}

.schedule-info {
  flex: 1;
}

.hall-name {
  display: block;
  font-size: 26rpx;
  color: #333;
}

.hall-type {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #999;
}

.schedule-price {
  text-align: right;
}

.price {
  display: block;
  font-size: 30rpx;
  color: #ff5f16;
  font-weight: 700;
}

.symbol {
  font-size: 22rpx;
}

.buy-btn {
  margin-top: 10rpx;
  min-width: 100rpx;
  height: 46rpx;
  border-radius: 23rpx;
  line-height: 46rpx;
  text-align: center;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
  font-size: 22rpx;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 24rpx;
}

.empty-wrap {
  background: #fff;
  border-radius: 14rpx;
  padding: 28rpx;
  text-align: center;
}

.empty-text {
  color: #999;
  font-size: 24rpx;
}
