.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.register-header {
  padding-top: 20rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #121212;
  display: block;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 24rpx;
  color: #999;
}

.register-form {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  width: 100%;
  height: 82rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input:focus {
  background-color: #fff;
  border-color: #ff5f16;
}

.input.error {
  border-color: #ff4d4f;
}

.error-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff4d4f;
}

.input-row {
  display: flex;
  align-items: center;
}

.input-row .input {
  flex: 1;
  margin-right: 20rpx;
}

.code-btn {
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 24rpx 28rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.code-btn:active {
  background-color: #e55a5a;
}

.code-btn.disabled {
  background-color: #ccc;
}

.protocol-row {
  display: flex;
  align-items: flex-start;
  margin: 30rpx 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.checkbox.checked {
  background-color: #ff5f16;
  border-color: #ff5f16;
}

.checkbox text {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.protocol-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.protocol-text .text {
  color: #999;
}

.protocol-text .link {
  color: #ff5f16;
}

.register-btn {
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 50rpx;
  margin-top: 40rpx;
  transition: all 0.3s ease;
}

.register-btn:active {
  background-color: #e55a5a;
  transform: scale(0.98);
}

.register-btn.loading {
  background-color: #ffb3b3;
}

.register-btn .loading-spinner {
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.login-link {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  font-size: 24rpx;
}

.text {
  color: #999;
}

.link {
  color: #ff5f16;
  margin-left: 8rpx;
}
