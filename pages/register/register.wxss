.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #fff;
  padding: 0 40rpx;
}

.register-header {
  padding-top: 80rpx;
  margin-bottom: 50rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #999;
}

.register-form {
  flex: 1;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input:focus {
  background-color: #fff;
  border-color: #FF6B6B;
}

.input.error {
  border-color: #ff4d4f;
}

.error-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff4d4f;
}

.input-row {
  display: flex;
  align-items: center;
}

.input-row .input {
  flex: 1;
  margin-right: 20rpx;
}

.code-btn {
  background-color: #FF6B6B;
  color: #fff;
  font-size: 26rpx;
  padding: 24rpx 28rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.code-btn:active {
  background-color: #e55a5a;
}

.code-btn.disabled {
  background-color: #ccc;
}

.protocol-row {
  display: flex;
  align-items: flex-start;
  margin: 30rpx 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.checkbox.checked {
  background-color: #FF6B6B;
  border-color: #FF6B6B;
}

.checkbox text {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.protocol-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.protocol-text .text {
  color: #999;
}

.protocol-text .link {
  color: #FF6B6B;
}

.register-btn {
  background-color: #FF6B6B;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 50rpx;
  margin-top: 40rpx;
  transition: all 0.3s ease;
}

.register-btn:active {
  background-color: #e55a5a;
  transform: scale(0.98);
}

.register-btn.loading {
  background-color: #ffb3b3;
}

.register-btn .loading-spinner {
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.login-link {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  font-size: 28rpx;
}

.text {
  color: #999;
}

.link {
  color: #FF6B6B;
  margin-left: 8rpx;
}
