<view class="container">
  <view class="register-header">
    <text class="title">{{type === 'login' ? '手机号登录' : '新用户注册'}}</text>
    <text class="desc">{{type === 'login' ? '输入手机号和密码登录' : '注册后可享受更多服务'}}</text>
  </view>

  <view class="register-form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input {{phoneError ? 'error' : ''}}" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
      <text class="error-tip" wx:if="{{phoneError}}">{{phoneError}}</text>
    </view>

    <view class="form-item">
      <text class="label">验证码</text>
      <view class="input-row">
        <input class="input" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" />
        <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="onSendCode">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </view>
      </view>
      <text class="error-tip" wx:if="{{codeError}}">{{codeError}}</text>
    </view>

    <block wx:if="{{type === 'register' || type === 'login'}}">
      <view class="form-item">
        <text class="label">设置密码</text>
        <input class="input {{passwordError ? 'error' : ''}}" type="password" placeholder="请设置密码（至少6位）" value="{{password}}" bindinput="onPasswordInput" />
        <text class="error-tip" wx:if="{{passwordError}}">{{passwordError}}</text>
      </view>

      <view class="form-item" wx:if="{{type === 'register'}}">
        <text class="label">确认密码</text>
        <input class="input {{confirmError ? 'error' : ''}}" type="password" placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
        <text class="error-tip" wx:if="{{confirmError}}">{{confirmError}}</text>
      </view>

      <view class="protocol-row" wx:if="{{type === 'register'}}" bindtap="toggleProtocol">
        <view class="checkbox {{agreeProtocol ? 'checked' : ''}}">
          <text wx:if="{{agreeProtocol}}">✓</text>
        </view>
        <text class="protocol-text">
          <text class="text">我已阅读并同意</text>
          <text class="link">《用户协议》</text>
          <text class="text">和</text>
          <text class="link">《隐私政策》</text>
        </text>
      </view>
    </block>

    <view class="register-btn {{loading ? 'loading' : ''}}" bindtap="onRegister">
      <text wx:if="{{!loading}}">{{type === 'login' ? '登录' : '注册'}}</text>
      <view class="loading-spinner" wx:else></view>
    </view>

    <view class="login-link">
      <text class="text">{{type === 'login' ? '没有账号？' : '已有账号？'}}</text>
      <text class="link" bindtap="onLogin">{{type === 'login' ? '立即注册' : '立即登录'}}</text>
    </view>
  </view>
</view>
