/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx 24rpx;
}

/* 区块样式 */
.section {
  background-color: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* FAQ列表 */
.faq-list {
  display: flex;
  flex-direction: column;
}

.faq-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding: 20rpx 0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.question-text {
  flex: 1;
  font-size: 25rpx;
  color: #333;
  font-weight: 500;
}

.question-arrow {
  font-size: 24rpx;
  color: #999;
  transition: transform 0.3s ease;
}

.question-arrow.open {
  transform: rotate(180deg);
}

.faq-answer {
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 联系方式列表 */
.contact-list {
  display: flex;
  flex-direction: column;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.contact-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.contact-content {
  font-size: 24rpx;
  color: #999;
}

.contact-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 意见反馈卡片 */
.feedback-card {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.feedback-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.feedback-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feedback-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.feedback-desc {
  font-size: 24rpx;
  color: #999;
}

.feedback-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 温馨提示卡片 */
.tips-card {
  background: #fff2eb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #ff5f16;
  margin-bottom: 16rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-line;
}
