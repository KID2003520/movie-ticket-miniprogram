.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 12rpx 24rpx 20rpx;
  box-sizing: border-box;
}

.collection-list {
  padding: 0;
}

.collection-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.movie-poster {
  width: 120rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.movie-info {
  flex: 1;
  margin-left: 20rpx;
}

.movie-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.collection-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.delete-btn {
  padding: 8rpx 18rpx;
  background: #fff2eb;
  color: #ff5f16;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-btn {
  padding: 16rpx 46rpx;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
  border-radius: 36rpx;
  font-size: 24rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
