<view class="container">
  <view class="form-section">
    <view class="section-title">基本信息</view>
    
    <view class="form-item required">
      <text class="label">用户名</text>
      <input class="input" placeholder="请输入用户名" value="{{form.nickName}}" bindinput="onNickNameInput" maxlength="20" />
    </view>

    <view class="form-item required">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onPhoneInput" maxlength="11" />
      <text class="error-tip" wx:if="{{phoneError}}">{{phoneError}}</text>
    </view>

    <view class="form-item required">
      <text class="label">密码</text>
      <view class="password-row">
        <input class="input" type="{{showPassword ? 'text' : 'password'}}" placeholder="请输入密码" value="{{form.password}}" bindinput="onPasswordInput" maxlength="20" />
        <view class="toggle-password" bindtap="onTogglePassword">
          <text>{{showPassword ? '隐藏' : '显示'}}</text>
        </view>
      </view>
      <view class="generate-btn" bindtap="onGeneratePassword">
        <text>自动生成随机密码</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">权限设置</view>
    
    <view class="form-item required">
      <text class="label">用户等级</text>
      <view class="level-options">
        <view class="level-option {{form.level === 'normal' ? 'active' : ''}}" bindtap="onLevelChange" data-level="normal">
          <text class="level-icon">👤</text>
          <text class="level-name">普通用户</text>
          <text class="level-desc">基础购票权限</text>
        </view>
        <view class="level-option {{form.level === 'vip' ? 'active' : ''}}" bindtap="onLevelChange" data-level="vip">
          <text class="level-icon">👑</text>
          <text class="level-name">会员</text>
          <text class="level-desc">享受会员优惠</text>
        </view>
        <view class="level-option {{form.level === 'admin' ? 'active' : ''}}" bindtap="onLevelChange" data-level="admin">
          <text class="level-icon">🛡️</text>
          <text class="level-name">管理员</text>
          <text class="level-desc">后台管理权限</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="label">账号状态</text>
      <view class="status-options">
        <view class="status-option {{form.status === 'active' ? 'active' : ''}}" bindtap="onStatusChange" data-status="active">
          <text>正常</text>
        </view>
        <view class="status-option {{form.status === 'disabled' ? 'active' : ''}}" bindtap="onStatusChange" data-status="disabled">
          <text>禁用</text>
        </view>
      </view>
    </view>
  </view>

  <view class="form-section" wx:if="{{isEdit}}">
    <view class="section-title">账号信息</view>
    
    <view class="info-item">
      <text class="info-label">注册时间</text>
      <text class="info-value">{{form.createTime || '-'}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">累计消费</text>
      <text class="info-value">¥{{form.totalSpent || 0}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">订单数量</text>
      <text class="info-value">{{form.orderCount || 0}}笔</text>
    </view>
  </view>

  <view class="form-actions">
    <view class="btn cancel" bindtap="onCancel">取消</view>
    <view class="btn submit" bindtap="onSubmit">{{isEdit ? '保存修改' : '添加用户'}}</view>
  </view>
</view>
