.movie-page {
  padding-bottom: 20rpx;
}

.movie-tab-bar {
  position: sticky;
  top: 0;
  z-index: 30;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
}

.movie-tab {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 30rpx;
  font-weight: 500;
  border-bottom: 4rpx solid transparent;
}

.movie-tab.active {
  color: #121212;
  font-weight: 700;
  border-bottom-color: #ff5f16;
}

.movie-list {
  background-color: #ffffff;
}

.movie-row {
  margin: 0 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #efefef;
  display: flex;
}

.row-poster {
  width: 136rpx;
  height: 188rpx;
  border-radius: 10rpx;
  background-color: #f1f1f1;
  flex-shrink: 0;
}

.row-poster-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #999;
  text-align: center;
  padding: 8rpx;
  box-sizing: border-box;
}

.row-main {
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
}

.row-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.row-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #121212;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-tag {
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #ff5f16;
  background-color: #fff2eb;
}

.row-tag.coming {
  color: #5e7ce0;
  background-color: #eef2ff;
}

.row-score {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ffb000;
  font-weight: 600;
}

.row-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a8a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-right {
  margin-left: 12rpx;
  width: 136rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-end;
}

.row-price {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: #ff5f16;
  font-weight: 700;
}

.price-symbol {
  font-size: 20rpx;
}

.row-btn {
  min-width: 112rpx;
  height: 52rpx;
  border-radius: 26rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 52rpx;
  text-align: center;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
}

.empty-wrap {
  padding: 130rpx 24rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 70rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #ededed;
  border-top: 4rpx solid #ff5f16;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #999;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
