<view class="container">
  <!-- 账号与隐私 -->
  <view class="section">
    <view class="section-title">账号与隐私</view>
    <view class="setting-item" bindtap="onProfileTap">
      <view class="setting-left">
        <text class="setting-icon">👤</text>
        <text class="setting-label">个人资料</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
  </view>

  <!-- 通用设置 -->
  <view class="section">
    <view class="section-title">通用设置</view>
    
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-icon">🔔</text>
        <text class="setting-label">消息通知</text>
      </view>
      <switch checked="{{settings.notification}}" bindchange="onSwitchChange" data-key="notification" color="#FF5722" />
    </view>
    
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-icon">▶️</text>
        <text class="setting-label">自动播放预告片</text>
      </view>
      <switch checked="{{settings.autoPlay}}" bindchange="onSwitchChange" data-key="autoPlay" color="#FF5722" />
    </view>
    
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-icon">🌙</text>
        <text class="setting-label">夜间模式</text>
      </view>
      <switch checked="{{settings.nightMode}}" bindchange="onSwitchChange" data-key="nightMode" color="#FF5722" />
    </view>
  </view>

  <!-- 存储管理 -->
  <view class="section">
    <view class="section-title">存储管理</view>
    
    <view class="setting-item" bindtap="onClearCache">
      <view class="setting-left">
        <text class="setting-icon">🗑️</text>
        <text class="setting-label">清除缓存</text>
      </view>
      <view class="setting-right">
        <text class="cache-size">{{cacheSize}}</text>
        <text class="setting-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 其他 -->
  <view class="section">
    <view class="section-title">其他</view>
    
    <view class="setting-item" bindtap="onFeedbackTap">
      <view class="setting-left">
        <text class="setting-icon">💬</text>
        <text class="setting-label">意见反馈</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
    
    <view class="setting-item" bindtap="onAboutTap">
      <view class="setting-left">
        <text class="setting-icon">ℹ️</text>
        <text class="setting-label">关于淘票票</text>
      </view>
      <view class="setting-right">
        <text class="version-text">v{{version}}</text>
        <text class="setting-arrow">></text>
      </view>
    </view>
    
    <view class="setting-item" bindtap="onPrivacyTap">
      <view class="setting-left">
        <text class="setting-icon">🔒</text>
        <text class="setting-label">隐私政策</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
    
    <view class="setting-item" bindtap="onUserAgreementTap">
      <view class="setting-left">
        <text class="setting-icon">📄</text>
        <text class="setting-label">用户协议</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>淘票票小程序 v{{version}}</text>
  </view>
</view>
