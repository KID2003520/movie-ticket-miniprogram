.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.filter-bar {
  background: #fff;
  padding: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.filter-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background: #f5f6fa;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.filter-item .arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #999;
}

.search-row {
  display: flex;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 140rpx;
  height: 72rpx;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.user-list {
  padding: 20rpx;
}

.user-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}

.level-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.level-tag.normal {
  background: #f5f6fa;
  color: #999;
}

.level-tag.vip {
  background: #fff3e0;
  color: #ff9800;
}

.level-tag.admin {
  background: #e3f2fd;
  color: #2196f3;
}

.user-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.user-stats {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 12rpx;
}

.stat {
  font-size: 24rpx;
  color: #666;
  margin-right: 24rpx;
}

.status-text {
  font-size: 24rpx;
  margin-left: auto;
}

.status-text.active {
  color: #4caf50;
}

.status-text.disabled {
  color: #f44336;
}

.user-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  margin-left: 16rpx;
}

.action-btn {
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
}

.action-btn.edit {
  background: #fff2eb;
  color: #ff5f16;
}

.action-btn.disable {
  background: #fff3e0;
  color: #ff9800;
}

.action-btn.enable {
  background: #e8f5e9;
  color: #4caf50;
}

.action-btn.reset {
  background: #f3e5f5;
  color: #9c27b0;
}

.action-btn.delete {
  background: #ffebee;
  color: #f44336;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.4);
}

.add-btn text {
  font-size: 60rpx;
  color: #fff;
  line-height: 1;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  color: #ff5f16;
  font-size: 28rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.modal-btn.cancel {
  background: #f5f6fa;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
}
