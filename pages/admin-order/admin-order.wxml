<view class="container">
  <view class="card filter-card">
    <text class="hint">支持按订单号、用户（昵称/手机/openid）、场次 ID、订单状态筛选；异常视图用于超时未付与待退款审批。</text>
    <view class="row">
      <text class="lab">状态</text>
      <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="onStatusPick">
        <view class="pick">{{statusLabels[statusIndex]}}</view>
      </picker>
    </view>
    <view class="row">
      <text class="lab">视图</text>
      <picker mode="selector" range="{{filterLabels}}" value="{{filterIndex}}" bindchange="onFilterPick">
        <view class="pick">{{filterLabels[filterIndex]}}</view>
      </picker>
    </view>
    <input class="inp" placeholder="订单号（模糊）" value="{{orderNo}}" bindinput="onOrderNo" />
    <input class="inp" placeholder="用户关键词" value="{{userKeyword}}" bindinput="onUserKw" />
    <input class="inp" placeholder="场次 scheduleId" value="{{scheduleId}}" bindinput="onScheduleId" />
    <view class="btn-row">
      <button class="btn primary" size="mini" bindtap="onSearch">检索</button>
      <button class="btn ghost" size="mini" bindtap="onReset">重置</button>
    </view>
    <text class="total" wx:if="{{total >= 0}}">共 {{total}} 条</text>
  </view>

  <view class="loading" wx:if="{{loading && items.length === 0}}">加载中…</view>

  <view class="list">
    <view
      class="item card"
      wx:for="{{items}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onItemTap"
    >
      <view class="item-top">
        <text class="ono">{{item.orderNo}}</text>
        <text class="pill {{item.status}}">{{item.statusLabel}}</text>
      </view>
      <text class="title">{{item.movieTitle}}</text>
      <text class="sub">{{item.cinemaName}} · {{item.date}} {{item.startTime}}</text>
      <text class="sub">用户 {{item.userNick || '—'}} · {{item.userPhone || item._openid}}</text>
      <view class="item-bot">
        <text class="price">¥{{item.priceYuan}}</text>
        <text class="rq" wx:if="{{item.refundRequestStatus === 'pending'}}">待退款审批</text>
      </view>
    </view>
  </view>

  <view class="more" wx:if="{{hasMore}}">
    <button class="btn ghost wide" size="mini" bindtap="onLoadMore" loading="{{loading}}">加载更多</button>
  </view>
  <view class="end" wx:if="{{!hasMore && items.length > 0}}">没有更多了</view>
</view>
