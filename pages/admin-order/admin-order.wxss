.container {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 20rpx;
  box-sizing: border-box;
  padding-bottom: 48rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.05);
}

.filter-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
  display: block;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.lab {
  width: 100rpx;
  font-size: 26rpx;
  color: #666;
}

.pick {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #f5f6fa;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #333;
}

.inp {
  height: 72rpx;
  padding: 0 20rpx;
  margin-bottom: 14rpx;
  background: #f5f6fa;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn.primary {
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
}

.btn.ghost {
  background: #fff;
  color: #ff5f16;
  border: 1rpx solid #ffb58d;
}

.total {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  padding: 24rpx;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.ono {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
  flex: 1;
  margin-right: 12rpx;
  word-break: break-all;
}

.pill {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #eee;
  color: #666;
}

.pill.pending {
  background: #fff3e0;
  color: #e65100;
}
.pill.paid {
  background: #e8f5e9;
  color: #2e7d32;
}
.pill.used {
  background: #e3f2fd;
  color: #1565c0;
}
.pill.cancelled {
  background: #f5f5f5;
  color: #757575;
}
.pill.refunded {
  background: #fce4ec;
  color: #c2185b;
}

.title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.sub {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
  line-height: 1.4;
}

.item-bot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.price {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff5f16;
}

.rq {
  font-size: 22rpx;
  color: #c0392b;
}

.more {
  margin-top: 24rpx;
}

.btn.wide {
  width: 100%;
}

.end {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #bbb;
}
