.container {
  padding-bottom: 20rpx;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.location {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.location-icon {
  font-size: 28rpx;
  margin-right: 4rpx;
}

.location-text {
  font-size: 28rpx;
  color: #333;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
}

.banner {
  width: 100%;
  height: 360rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.section {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #fff;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

.movie-scroll {
  white-space: nowrap;
  margin: 0 -20rpx;
  padding: 0 20rpx;
}

.movie-list {
  display: inline-flex;
  padding-bottom: 10rpx;
}

.movie-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
}

.movie-poster {
  width: 200rpx;
  height: 280rpx;
  border-radius: 12rpx;
}

.movie-info {
  padding: 10rpx 0;
}

.movie-title {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.movie-rating {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.rating-value {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.rating-label {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.movie-price {
  font-size: 26rpx;
  color: #FF6B6B;
  margin-top: 6rpx;
  display: block;
}

.movie-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.movie-card {
  width: 48%;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-poster {
  width: 100%;
  height: 320rpx;
}

.card-info {
  padding: 16rpx;
}

.card-title {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.card-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.card-rating {
  font-size: 24rpx;
  color: #FF6B6B;
  margin-right: 16rpx;
}

.card-genre {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.card-date {
  font-size: 24rpx;
  color: #999;
}

.card-price {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin-top: 8rpx;
  display: block;
}

.coming-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #ff976a;
  border: 1rpx solid #ff976a;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-top: 8rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
