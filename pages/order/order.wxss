.order-page {
  padding: 10rpx 24rpx 20rpx;
  box-sizing: border-box;
}

.status-scroll {
  white-space: nowrap;
}

.status-bar {
  display: inline-flex;
  background-color: #fff;
  border-radius: 14rpx;
  padding: 8rpx;
  min-width: 100%;
  box-sizing: border-box;
}

.status-item {
  min-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  border-radius: 28rpx;
}

.status-item.active {
  color: #fff;
  font-weight: 700;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
}

.order-list {
  margin-top: 14rpx;
}

.order-item {
  background-color: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 21rpx;
  color: #999;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
}

.status-tag.pending {
  color: #ff8b00;
  background-color: #fff4e7;
}

.status-tag.paid {
  color: #18a058;
  background-color: #ebfaf2;
}

.status-tag.cancelled,
.status-tag.refunded {
  color: #999;
  background-color: #f5f5f5;
}

.order-main {
  margin-top: 14rpx;
  display: flex;
}

.movie-poster {
  width: 118rpx;
  height: 156rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.movie-main {
  margin-left: 12rpx;
  flex: 1;
  min-width: 0;
}

.movie-title {
  display: block;
  font-size: 29rpx;
  color: #121212;
  font-weight: 700;
}

.movie-meta {
  display: block;
  margin-top: 7rpx;
  font-size: 22rpx;
  color: #8a8a8a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-list {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.seat-item {
  font-size: 21rpx;
  color: #ff5f16;
  background-color: #fff2eb;
  border-radius: 6rpx;
  padding: 4rpx 8rpx;
}

.order-foot {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total {
  font-size: 25rpx;
  color: #333;
  font-weight: 600;
}

.actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.btn-pay,
.btn-del {
  min-width: 96rpx;
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 22rpx;
  border-radius: 23rpx;
}

.btn-pay {
  color: #fff;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
}

.btn-pay.alipay {
  color: #fff;
  background: linear-gradient(90deg, #1677ff 0%, #0958d9 100%);
}

.btn-del {
  color: #ff5f16;
  background-color: #fff2eb;
}

.empty,
.loading {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 80rpx 0;
}
