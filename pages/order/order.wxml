<view class="container order-page">
  <scroll-view scroll-x class="status-scroll" show-scrollbar="{{false}}">
    <view class="status-bar">
      <view class="status-item {{currentStatus === item.value ? 'active' : ''}}" wx:for="{{statusList}}" wx:key="value" bindtap="onStatusChange" data-status="{{item.value}}">
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="order-list">
    <view class="order-item" wx:for="{{orders}}" wx:key="_id" bindtap="onOrderTap" data-id="{{item._id}}">
      <view class="order-head">
        <text class="order-no">订单号 {{item.orderNo}}</text>
        <text class="status-tag {{item.status}}">
          {{item.status === 'pending' ? '待支付' : item.status === 'paid' ? '已支付' : item.status === 'cancelled' ? '已取消' : item.status === 'refunded' ? '已退款' : '已完成'}}
        </text>
      </view>
      <view class="order-main">
        <image src="{{item.moviePoster}}" mode="aspectFill" class="movie-poster"></image>
        <view class="movie-main">
          <text class="movie-title">{{item.movieTitle}}</text>
          <text class="movie-meta">{{item.cinemaName}}</text>
          <text class="movie-meta">{{item.date}} {{item.startTime}} {{item.hallName}}</text>
          <view class="seat-list">
            <text class="seat-item" wx:for="{{item.seats}}" wx:key="index">{{item.row}}排{{item.col}}座</text>
          </view>
        </view>
      </view>
      <view class="order-foot">
        <text class="total">合计 ¥{{item.totalPrice}}</text>
        <view class="actions">
          <view
            wx:if="{{item.status === 'pending' && alipayEnabled}}"
            class="btn-pay alipay"
            catchtap="onAlipayPay"
            data-id="{{item._id}}"
          >支付宝</view>
          <view wx:if="{{item.status === 'pending'}}" class="btn-pay" catchtap="onPay" data-id="{{item._id}}">支付</view>
          <view wx:if="{{item.status === 'cancelled' || item.status === 'refunded'}}" class="btn-del" catchtap="onDelete" data-id="{{item._id}}">删除</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && orders.length === 0}}" class="empty">暂无订单</view>
  <view wx:if="{{loading}}" class="loading">加载中...</view>
</view>
