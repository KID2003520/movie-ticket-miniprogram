<view class="container">
  <view class="status-bar">
    <view class="status-item {{currentStatus === item.value ? 'active' : ''}}" wx:for="{{statusList}}" wx:key="value" bindtap="onStatusChange" data-status="{{item.value}}">
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="order-list">
    <view class="order-item" wx:for="{{orders}}" wx:key="_id" bindtap="onOrderTap" data-id="{{item._id}}">
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo}}</text>
        <text class="status-tag {{item.status}}">{{item.status === 'pending' ? '待支付' : item.status === 'paid' ? '已支付' : '已完成'}}</text>
      </view>
      <view class="order-content">
        <image src="{{item.moviePoster}}" mode="aspectFill" class="movie-poster"></image>
        <view class="movie-info">
          <text class="movie-title">{{item.movieTitle}}</text>
          <text class="movie-meta">{{item.cinemaName}}</text>
          <text class="movie-meta">{{item.date}} {{item.startTime}}</text>
          <text class="movie-meta">{{item.hallName}}</text>
          <view class="seat-info">
            <text class="seat-text" wx:for="{{item.seats}}" wx:key="index">{{item.row}}排{{item.col}}座</text>
          </view>
        </view>
      </view>
      <view class="order-footer">
        <view class="price-info">
          <text class="price-label">总价</text>
          <text class="price-value">{{item.totalPrice}}元</text>
        </view>
        <view class="action-btns">
          <view wx:if="{{item.status === 'pending'}}" class="pay-btn" catchtap="onPay" data-id="{{item._id}}">支付</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && orders.length === 0}}" class="empty-state">
    <text>暂无订单</text>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</view>
