.detail-page {
  padding-bottom: 124rpx;
}

.detail-wrapper {
  padding-top: 14rpx;
}

.hero-card {
  margin: 0 24rpx;
  height: 380rpx;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
}

.hero-bg {
  width: 100%;
  height: 100%;
  filter: blur(24rpx);
  transform: scale(1.2);
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.35));
}

.hero-main {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
}

.hero-poster {
  width: 168rpx;
  height: 228rpx;
  border-radius: 10rpx;
}

.hero-info {
  margin-left: 18rpx;
  color: #fff;
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-score {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #ffd24d;
}

.hero-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  opacity: 0.9;
}

.quick-actions {
  margin: 16rpx 24rpx 0;
  background-color: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  display: flex;
  gap: 16rpx;
}

.tag-row {
  margin: 14rpx 24rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: #fff4ed;
  color: #ff6f2b;
  font-size: 22rpx;
}

.action-item {
  flex: 1;
  height: 62rpx;
  border-radius: 31rpx;
  background-color: #f7f7f7;
  color: #333;
  font-size: 24rpx;
  line-height: 62rpx;
  text-align: center;
}

.block {
  margin: 16rpx 24rpx 0;
  border-radius: 14rpx;
  background-color: #fff;
  padding: 22rpx;
}

.block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.block-title {
  font-size: 30rpx;
  color: #121212;
  font-weight: 700;
}

.block-more {
  font-size: 24rpx;
  color: #999;
}

.block-text {
  margin-top: 14rpx;
  display: block;
  font-size: 25rpx;
  line-height: 1.7;
  color: #555;
}

.crew-row {
  display: flex;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.crew-label {
  width: 76rpx;
  color: #999;
}

.crew-value {
  flex: 1;
  color: #444;
}

.gallery-scroll {
  margin-top: 14rpx;
  white-space: nowrap;
}

.gallery-img {
  width: 280rpx;
  height: 160rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
  display: inline-block;
}

.comment-item {
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 0;
}

.comment-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-name {
  font-size: 25rpx;
  color: #333;
  font-weight: 600;
}

.comment-user {
  display: flex;
  align-items: center;
}

.comment-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.comment-time {
  font-size: 21rpx;
  color: #999;
}

.comment-score {
  display: block;
  margin-top: 8rpx;
  color: #ff8b2c;
  font-size: 22rpx;
}

.comment-content {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.empty-comments {
  margin-top: 20rpx;
  text-align: center;
  color: #999;
  font-size: 23rpx;
}

.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 104rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.buy-left {
  display: flex;
  flex-direction: column;
}

.buy-price {
  font-size: 34rpx;
  color: #ff5f16;
  font-weight: 700;
}

.symbol {
  font-size: 22rpx;
}

.buy-tip {
  font-size: 22rpx;
  color: #999;
}

.buy-btn {
  min-width: 180rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  font-weight: 700;
}

.comment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.comment-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.comment-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.rating-select {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.rating-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
}

.stars .star {
  font-size: 40rpx;
  color: #ddd;
  margin-right: 10rpx;
}

.stars .star.active {
  color: #FFD700;
}

.comment-input {
  width: 100%;
  height: 200rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
  margin-right: 20rpx;
}

.submit-btn {
  background-color: #FF6B6B;
  color: #fff;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 24rpx;
}
