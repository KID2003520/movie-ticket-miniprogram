<view class="container detail-page">
  <view wx:if="{{movie}}" class="detail-wrapper">
    <view class="hero-card">
      <image src="{{movieView.poster}}" mode="aspectFill" class="hero-bg"></image>
      <view class="hero-mask"></view>
      <view class="hero-main">
        <image src="{{movieView.poster}}" mode="aspectFill" class="hero-poster"></image>
        <view class="hero-info">
          <text class="hero-title">{{movie.title}}</text>
          <text class="hero-score">{{movieView.score}} 分</text>
          <text class="hero-meta">{{movieView.genreText}} | {{movieView.duration}}</text>
          <text class="hero-meta">{{movieView.releaseDate}} 上映</text>
          <text wx:if="{{enriching}}" class="hero-meta">正在补全影片资料...</text>
        </view>
      </view>
    </view>

    <view class="tag-row">
      <text class="tag-item" wx:for="{{movieView.tags}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="quick-actions">
      <view class="action-item" bindtap="onCollect">{{isCollected ? '已收藏' : '收藏'}}</view>
      <view class="action-item" bindtap="onShowCommentInput">写短评</view>
    </view>

    <view class="block">
      <text class="block-title">剧情简介</text>
      <text class="block-text">{{movieView.description}}</text>
    </view>

    <view class="block">
      <text class="block-title">影片信息</text>
      <view class="crew-row">
        <text class="crew-label">状态</text>
        <text class="crew-value">{{movieView.statusLabel}}</text>
      </view>
      <view class="crew-row">
        <text class="crew-label">类型</text>
        <text class="crew-value">{{movieView.genreText}}</text>
      </view>
      <view class="crew-row">
        <text class="crew-label">时长</text>
        <text class="crew-value">{{movieView.duration}}</text>
      </view>
      <view class="crew-row">
        <text class="crew-label">上映</text>
        <text class="crew-value">{{movieView.releaseDate}}</text>
      </view>
    </view>

    <view class="block">
      <text class="block-title">演职人员</text>
      <view class="crew-row">
        <text class="crew-label">导演</text>
        <text class="crew-value">{{movieView.director}}</text>
      </view>
      <view class="crew-row">
        <text class="crew-label">主演</text>
        <text class="crew-value">{{movieView.actors}}</text>
      </view>
    </view>

    <view class="block" wx:if="{{gallery.length > 0}}">
      <view class="block-head">
        <text class="block-title">电影图片</text>
        <text class="block-more">点击可预览</text>
      </view>
      <scroll-view class="gallery-scroll" scroll-x enable-flex>
        <image
          wx:for="{{gallery}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="gallery-img"
          data-url="{{item}}"
          bindtap="onPreviewImage"
        ></image>
      </scroll-view>
    </view>

    <view class="block">
      <view class="block-head">
        <text class="block-title">观众评论 ({{comments.length}})</text>
        <text class="block-more" bindtap="onShowCommentInput">去评价</text>
      </view>
      <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
        <view class="comment-top">
          <view class="comment-user">
            <image class="comment-avatar" mode="aspectFill" src="{{item.avatarUrl || 'https://picsum.photos/80/80?random=700'}}"></image>
            <text class="comment-name">{{item.nickName}}</text>
          </view>
          <text class="comment-time">{{item.createTime}}</text>
        </view>
        <text class="comment-score">评分：{{item.rating || 5}} / 5</text>
        <text class="comment-content">{{item.content}}</text>
      </view>
      <view wx:if="{{comments.length===0}}" class="empty-comments">还没有评论，快来抢沙发</view>
    </view>

    <view class="buy-bar">
      <view class="buy-left">
        <text class="buy-price"><text class="symbol">¥</text>{{movieView.priceText}}</text>
        <text class="buy-tip">起售票价</text>
      </view>
      <view class="buy-btn" bindtap="onBuyTicket">特惠购票</view>
    </view>
  </view>

  <view wx:if="{{showCommentInput}}" class="comment-modal">
    <view class="comment-modal-mask" bindtap="onHideCommentInput"></view>
    <view class="comment-modal-content">
      <view class="modal-header">
        <text class="modal-title">发表评论</text>
        <text class="modal-close" bindtap="onHideCommentInput">×</text>
      </view>
      <view class="rating-select">
        <text class="rating-label">评分：</text>
        <view class="stars">
          <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{item <= commentRating ? 'active' : ''}}" bindtap="onRatingChange" data-rating="{{item}}">★</text>
        </view>
      </view>
      <textarea class="comment-input" placeholder="说说你的看法..." value="{{commentText}}" bindinput="onCommentInput" maxlength="200"></textarea>
      <view class="modal-footer">
        <view class="cancel-btn" bindtap="onHideCommentInput">取消</view>
        <view class="submit-btn" bindtap="onSubmitComment">提交</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
</view>
