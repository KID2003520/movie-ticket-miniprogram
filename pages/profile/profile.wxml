<view class="page">
  <view class="sync-row">
    <text class="sync-text">{{loadingRemote ? '正在同步服务器…' : '已优先展示本地缓存，下拉可刷新'}}</text>
  </view>

  <view class="hint" wx:if="{{useBackend && !existsInDb}}">当前账号尚未写入服务端，请使用「手机号注册 / 登录」后资料可云端保存与脱敏展示。</view>

  <view class="card">
    <view class="row">
      <text class="label">头像</text>
      <view class="avatar-wrap">
        <button type="default" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar" src="{{displayAvatar}}" mode="aspectFill" />
        </button>
      </view>
    </view>
    <view class="row">
      <text class="label">昵称</text>
      <input class="input" value="{{nickName}}" maxlength="32" placeholder="请输入昵称" bindinput="onNickInput" />
    </view>
    <view class="row">
      <text class="label">手机号</text>
      <text class="value">{{phoneMasked || '未绑定'}}</text>
    </view>
    <view class="btn-line" wx:if="{{useBackend && existsInDb && hasPassword}}" bindtap="openPhoneModal">更换手机号（需验证密码）</view>
  </view>

  <view class="card">
    <view class="label" style="display:block;margin-bottom:8rpx;">偏好标签（最多 8 个）</view>
    <view class="tag-grid">
      <view
        class="tag {{preferenceTags.indexOf(item) >= 0 ? 'tag-on' : ''}}"
        wx:for="{{presetTags}}"
        wx:key="*this"
        data-tag="{{item}}"
        bindtap="onToggleTag"
      >{{item}}</view>
    </view>
  </view>

  <view class="btn-primary" bindtap="onSaveProfile">保存资料</view>
</view>

<view class="modal-mask" wx:if="{{phoneModal}}" catchtouchmove="noop" bindtap="closePhoneModal">
  <view class="modal" catchtap="noop">
    <view class="modal-title">更换手机号</view>
    <view class="hint">需输入登录密码进行二次校验。</view>
    <view class="modal-field">
      <view class="modal-label">新手机号</view>
      <input class="modal-input" type="number" maxlength="11" placeholder="11 位手机号" value="{{newPhone}}" bindinput="onNewPhoneInput" />
    </view>
    <view class="modal-field">
      <view class="modal-label">登录密码</view>
      <input class="modal-input" password placeholder="请输入当前账号密码" value="{{verifyPassword}}" bindinput="onPwdInput" />
    </view>
    <view class="modal-actions">
      <view class="modal-cancel" bindtap="closePhoneModal">取消</view>
      <view class="modal-ok" bindtap="submitPhoneChange">确认更换</view>
    </view>
  </view>
</view>
