.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: #f5f6f8;
}

.hint {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #666;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #eee;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #f2f2f2;
  color: #555;
  border: 2rpx solid transparent;
}

.tag-on {
  background: rgba(255, 95, 22, 0.12);
  color: #ff5f16;
  border-color: #ff5f16;
}

.btn-primary {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 22rpx 0;
  text-align: center;
  font-weight: 600;
}

.btn-line {
  margin-top: 16rpx;
  background: #fff;
  color: #ff5f16;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  border: 2rpx solid #ff5f16;
}

.sync-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sync-text {
  font-size: 24rpx;
  color: #999;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx 28rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.modal-field {
  margin-bottom: 20rpx;
}

.modal-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.modal-input {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.modal-actions view {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.modal-cancel {
  background: #f2f2f2;
  color: #666;
}

.modal-ok {
  background: #ff5f16;
  color: #fff;
}
