.user-page {
  padding: 20rpx 24rpx 30rpx;
  box-sizing: border-box;
}

.profile-card {
  border-radius: 18rpx;
  padding: 26rpx;
  background: linear-gradient(135deg, #ff7a00 0%, #ff4d22 100%);
  display: flex;
  align-items: center;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  background-color: #ffffff;
}

.profile-main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.nickname {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
}

.arrow {
  color: #999;
  font-size: 24rpx;
}

.profile-card .arrow {
  color: rgba(255, 255, 255, 0.95);
}

.logout-wrap {
  margin-top: 14rpx;
}

.logout-btn {
  height: 72rpx;
  border-radius: 36rpx;
  border: 2rpx solid #ffd5c2;
  color: #ff5f16;
  background-color: #fff8f4;
  text-align: center;
  line-height: 72rpx;
  font-size: 26rpx;
}

.panel {
  margin-top: 18rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 18rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #121212;
}

.panel-more {
  font-size: 23rpx;
  color: #999;
}

.order-grid {
  display: flex;
  padding-bottom: 8rpx;
}

.order-cell {
  flex: 1;
  text-align: center;
}

.cell-name {
  display: block;
  color: #666;
  font-size: 24rpx;
}

.cell-num {
  display: block;
  margin-top: 10rpx;
  color: #ff5f16;
  font-size: 30rpx;
  font-weight: 700;
}

.menu-item {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #efefef;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  font-size: 28rpx;
  color: #121212;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-count {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background-color: #ff5f16;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}

.menu-right .arrow {
  margin-left: 12rpx;
}

.admin-entry {
  margin-top: 18rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
  padding: 22rpx 20rpx;
}

.admin-title {
  display: block;
  color: #121212;
  font-size: 28rpx;
  font-weight: 700;
}

.admin-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a8a8a;
  font-size: 22rpx;
}
