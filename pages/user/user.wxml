<view class="container">
  <view class="user-header">
    <view class="user-info" bindtap="onLogin">
      <image src="{{isLogin ? userInfo.avatarUrl : 'https://picsum.photos/100/100?random=999'}}" class="avatar"></image>
      <view class="info">
        <text class="nickname">{{isLogin ? userInfo.nickName : '点击登录'}}</text>
        <text class="desc">{{isLogin ? '欢迎回来' : '登录后享受更多服务'}}</text>
      </view>
    </view>
  </view>

  <view class="order-section">
    <view class="section-header">
      <text class="section-title">我的订单</text>
      <view class="section-more" bindtap="onOrderTap">
        <text>全部订单</text>
        <text class="arrow">></text>
      </view>
    </view>
    <view class="order-tabs">
      <view class="order-tab" bindtap="onOrderTap">
        <text class="tab-icon">⏱</text>
        <text>待支付</text>
      </view>
      <view class="order-tab" bindtap="onOrderTap">
        <text class="tab-icon">🎫</text>
        <text>已支付</text>
      </view>
      <view class="order-tab" bindtap="onOrderTap">
        <text class="tab-icon">✅</text>
        <text>已完成</text>
      </view>
      <view class="order-tab" bindtap="onOrderTap">
        <text class="tab-icon">💰</text>
        <text>退款</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="title" bindtap="onMenuTap" data-url="{{item.url}}">
      <text class="menu-title">{{item.title}}</text>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="admin-section" wx:if="{{isAdmin}}" bindtap="onAdminTap">
    <view class="admin-icon">🛡️</view>
    <view class="admin-content">
      <text class="admin-title">管理员后台</text>
      <text class="admin-desc">进入管理后台管理电影和用户</text>
    </view>
    <text class="arrow">></text>
  </view>
</view>
