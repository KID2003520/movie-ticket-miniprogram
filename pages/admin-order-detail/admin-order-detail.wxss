.container {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 20rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.05);
}

.block {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.row1 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ono {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
  flex: 1;
  word-break: break-all;
}

.pill {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.pill.pending {
  background: #fff3e0;
  color: #e65100;
}
.pill.paid {
  background: #e8f5e9;
  color: #2e7d32;
}
.pill.used {
  background: #e3f2fd;
  color: #1565c0;
}
.pill.cancelled {
  background: #f5f5f5;
  color: #757575;
}
.pill.refunded {
  background: #fce4ec;
  color: #c2185b;
}

.t {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.s {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 10rpx;
  line-height: 1.45;
}

.warn {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #fff5f5;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #c0392b;
}

.lab {
  font-size: 24rpx;
  color: #666;
}

.ta {
  width: 100%;
  min-height: 120rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f5f6fa;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn {
  font-size: 28rpx;
}

.btn.primary {
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
}

.btn.ghost {
  background: #fff;
  color: #ff5f16;
  border: 1rpx solid #ffb58d;
}

.btn.danger {
  background: #fff;
  color: #c0392b;
  border: 1rpx solid #e57373;
}

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
