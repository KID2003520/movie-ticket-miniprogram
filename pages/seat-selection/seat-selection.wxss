.seat-page {
  padding: 16rpx 24rpx 124rpx;
  box-sizing: border-box;
}

.session-card {
  background-color: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
}

.movie-poster {
  width: 100rpx;
  height: 136rpx;
  border-radius: 8rpx;
}

.session-main {
  flex: 1;
  margin-left: 14rpx;
}

.movie-title {
  display: block;
  font-size: 30rpx;
  color: #121212;
  font-weight: 700;
}

.movie-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

.screen-wrap {
  margin-top: 18rpx;
  text-align: center;
}

.screen {
  width: 420rpx;
  margin: 0 auto;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 0 0 100rpx 100rpx;
  background: linear-gradient(to bottom, #e7e7e7, #f7f7f7);
  font-size: 20rpx;
  color: #9a9a9a;
}

.seat-scroll {
  margin-top: 16rpx;
}

.seat-container {
  background-color: #fff;
  border-radius: 14rpx;
  padding: 16rpx;
  display: inline-block;
}

.seat-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.row-label {
  width: 32rpx;
  text-align: center;
  color: #999;
  font-size: 20rpx;
}

.seat-col {
  margin: 0 4rpx;
}

.seat {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx 8rpx 6rpx 6rpx;
}

.seat.available {
  background-color: #fff;
  border: 2rpx solid #d9d9d9;
}

.seat.selected {
  background-color: #ff5f16;
  border: 2rpx solid #ff5f16;
}

.seat.sold {
  background-color: #d8d8d8;
}

.seat.locked {
  background-color: #e9e9e9;
  border: 2rpx solid #cdcdcd;
}

.legend {
  margin-top: 14rpx;
  display: flex;
  justify-content: center;
  gap: 22rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #666;
}

.legend-seat {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border-radius: 6rpx;
}

.legend-seat.available {
  background-color: #fff;
  border: 2rpx solid #d9d9d9;
}

.legend-seat.selected {
  background-color: #ff5f16;
}

.legend-seat.sold {
  background-color: #d8d8d8;
}

.legend-seat.locked {
  background-color: #e9e9e9;
  border: 2rpx solid #cdcdcd;
}

.selected-bar {
  margin-top: 14rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
}

.selected-title {
  font-size: 24rpx;
  color: #333;
  margin-right: 12rpx;
}

.selected-list {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.selected-seat {
  font-size: 22rpx;
  color: #ff5f16;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background-color: #fff2eb;
}

.selected-coupon {
  margin-top: 12rpx;
}

.coupon-tag {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
}

.coupon-name {
  flex: 1;
  color: #333;
}

.coupon-discount,
.coupon-remove {
  color: #ff5f16;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 102rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background-color: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.left-area {
  display: flex;
  flex-direction: column;
}

.total {
  font-size: 34rpx;
  color: #ff5f16;
  font-weight: 700;
}

.coupon-btn {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #666;
}

.submit-btn {
  min-width: 178rpx;
  height: 62rpx;
  border-radius: 31rpx;
  line-height: 62rpx;
  text-align: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
}

.submit-btn.disabled {
  background: #ccc;
}

/* 优惠券选择弹窗 */
.coupon-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.coupon-picker {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.picker-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.picker-content {
  max-height: 60vh;
  padding: 20rpx 24rpx;
}

.coupon-option {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.option-left {
  width: 180rpx;
  background: linear-gradient(135deg, #FF5722 0%, #FF7043 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  color: #fff;
}

.option-amount {
  font-size: 48rpx;
  font-weight: bold;
}

.option-condition {
  font-size: 22rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}

.option-right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.option-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 24rpx;
}
