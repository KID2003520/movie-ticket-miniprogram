<view class="container">
  <view class="login-header">
    <view class="logo">🎬</view>
    <text class="title">电影购票</text>
    <text class="desc">{{loginType === 'phone_register' ? '手机号注册' : '使用手机号登录'}}</text>
  </view>

  <view class="login-content">
    <block wx:if="{{loginType === 'phone_login'}}">
      <view class="phone-login-area">
        <view class="form-item">
          <text class="label">手机号</text>
          <input class="input {{phoneError ? 'error' : ''}}" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
          <text class="error-tip" wx:if="{{phoneError}}">{{phoneError}}</text>
        </view>

        <view class="form-item">
          <text class="label">密码</text>
          <view class="input-wrap {{passwordError ? 'error' : ''}}">
            <input
              class="input input-inner"
              type="text"
              password="{{!showPassword}}"
              placeholder="请输入密码"
              value="{{password}}"
              bindinput="onPasswordInput"
            />
            <text class="pwd-toggle" bindtap="toggleShowPassword">{{showPassword ? '隐藏' : '显示'}}</text>
          </view>
          <text class="error-tip" wx:if="{{passwordError}}">{{passwordError}}</text>
        </view>

        <view class="login-btn primary" bindtap="onPasswordLogin">
          <text>登录</text>
        </view>

        <view class="login-link">
          <text class="text">没有账号？</text>
          <text class="link" bindtap="onGoRegister">立即注册</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{loginType === 'phone_register'}}">
      <view class="phone-login-area">
        <view class="form-item">
          <text class="label">手机号</text>
          <input class="input {{phoneError ? 'error' : ''}}" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
          <text class="error-tip" wx:if="{{phoneError}}">{{phoneError}}</text>
        </view>

        <view class="form-item">
          <text class="label">设置密码</text>
          <view class="input-wrap {{passwordError ? 'error' : ''}}">
            <input
              class="input input-inner"
              type="text"
              password="{{!showRegPassword}}"
              placeholder="请设置密码（至少6位）"
              value="{{password}}"
              bindinput="onPasswordInput"
            />
            <text class="pwd-toggle" bindtap="toggleShowRegPassword">{{showRegPassword ? '隐藏' : '显示'}}</text>
          </view>
          <text class="error-tip" wx:if="{{passwordError}}">{{passwordError}}</text>
        </view>

        <view class="form-item">
          <text class="label">确认密码</text>
          <view class="input-wrap {{confirmError ? 'error' : ''}}">
            <input
              class="input input-inner"
              type="text"
              password="{{!showRegConfirmPassword}}"
              placeholder="请再次输入密码"
              value="{{confirmPassword}}"
              bindinput="onConfirmPasswordInput"
            />
            <text class="pwd-toggle" bindtap="toggleShowRegConfirmPassword">{{showRegConfirmPassword ? '隐藏' : '显示'}}</text>
          </view>
          <text class="error-tip" wx:if="{{confirmError}}">{{confirmError}}</text>
        </view>

        <view class="protocol-row">
          <view class="checkbox {{agreeProtocol ? 'checked' : ''}}" bindtap="toggleProtocol">
            <text wx:if="{{agreeProtocol}}">✓</text>
          </view>
          <text class="protocol-text">
            <text class="text">我已阅读并同意</text>
            <text class="link">《用户协议》</text>
            <text class="text">和</text>
            <text class="link">《隐私政策》</text>
          </text>
        </view>

        <view class="login-btn primary" bindtap="onRegister">
          <text>注册</text>
        </view>

        <view class="login-link">
          <text class="text">已有账号？</text>
          <text class="link" bindtap="onGoLogin">立即登录</text>
        </view>
      </view>
    </block>
  </view>

  <view class="login-footer">
    <text class="agreement">登录即表示同意</text>
    <text class="link">《用户协议》</text>
    <text class="agreement">和</text>
    <text class="link">《隐私政策》</text>
  </view>
</view>
