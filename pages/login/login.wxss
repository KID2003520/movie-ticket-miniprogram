.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #fff;
  padding: 0 60rpx;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  margin-bottom: 40rpx;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #999;
}

.login-type-tabs {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 8rpx;
  margin-bottom: 60rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.tab.active {
  background-color: #FF6B6B;
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.3);
}

.tab-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.login-content {
  flex: 1;
}

.wechat-login-area {
  display: flex;
  flex-direction: column;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  border-radius: 50rpx;
  margin-bottom: 30rpx;
  font-size: 32rpx;
  transition: all 0.3s ease;
}

.login-btn.primary {
  background-color: #FF6B6B;
  color: #fff;
}

.login-btn.primary:active {
  background-color: #e55a5a;
  transform: scale(0.98);
}

.login-btn.default {
  background-color: #f5f5f5;
  color: #333;
}

.login-btn.default:active {
  background-color: #e8e8e8;
}

.btn-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}

.wechat-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

.sub-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.phone-login-area {
  padding: 0 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input:focus {
  background-color: #fff;
  border-color: #FF6B6B;
}

.input.error {
  border-color: #ff4d4f;
}

.error-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff4d4f;
}

.forgot-password {
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #999;
}

.divider {
  display: flex;
  align-items: center;
  margin: 50rpx 0;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background-color: #e5e5e5;
}

.divider text {
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #999;
}

.login-footer {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  padding: 40rpx 0;
  font-size: 24rpx;
}

.agreement {
  color: #999;
}

.link {
  color: #FF6B6B;
}
