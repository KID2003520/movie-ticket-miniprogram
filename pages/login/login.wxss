.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 36rpx;
  margin-bottom: 24rpx;
}

.logo {
  font-size: 88rpx;
  margin-bottom: 18rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #121212;
  margin-bottom: 10rpx;
}

.desc {
  font-size: 24rpx;
  color: #999;
}

.login-type-tabs {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 8rpx;
  margin-bottom: 60rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.tab.active {
  background-color: #FF6B6B;
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.3);
}

.tab-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.login-content {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.wechat-login-area {
  display: flex;
  flex-direction: column;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  transition: all 0.3s ease;
}

.login-btn.primary {
  background: linear-gradient(90deg, #ff7a00 0%, #ff4d22 100%);
  color: #fff;
}

.login-btn.primary:active {
  background-color: #e55a5a;
  transform: scale(0.98);
}

.login-btn.default {
  background-color: #fff2eb;
  color: #ff5f16;
}

.login-btn.default:active {
  background-color: #e8e8e8;
}

.btn-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}

.wechat-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

.sub-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.phone-login-area {
  padding: 0;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.input-wrap {
  display: flex;
  align-items: center;
  height: 82rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding-right: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.input-wrap.error {
  border-color: #ff4d4f;
}

.input {
  width: 100%;
  height: 82rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-inner {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0 0 0 24rpx;
  background: transparent;
  border: none;
}

.pwd-toggle {
  flex-shrink: 0;
  padding: 0 12rpx;
  font-size: 24rpx;
  color: #999;
}

.input:focus {
  background-color: #fff;
  border-color: #ff5f16;
}

.input.error {
  border-color: #ff4d4f;
}

.error-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff4d4f;
}

.forgot-password {
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #999;
}

.divider {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background-color: #e5e5e5;
}

.divider text {
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #999;
}

.login-footer {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  padding: 30rpx 0 10rpx;
  font-size: 22rpx;
}

.agreement {
  color: #999;
}

.link {
  color: #ff5f16;
}

.login-link {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-top: 20rpx;
  color: #999;
}

.text {
  color: #999;
}

.input-row {
  display: flex;
  align-items: center;
}

.code-btn {
  width: 220rpx;
  height: 88rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FF6B6B;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.code-btn.disabled {
  background-color: #f5f5f5;
  color: #999;
}

.protocol-row {
  display: flex;
  align-items: flex-start;
  margin: 30rpx 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e5e5e5;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background-color: #fff;
}

.checkbox.checked {
  border-color: #ff5f16;
  background-color: #fff2eb;
  color: #ff5f16;
}

.protocol-text {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}
